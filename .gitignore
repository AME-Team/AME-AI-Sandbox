# ============================================================
#  AME-AI-Sandbox .gitignore
#  ソースのみ追跡し、ビルド生成物・キャッシュ・一時ファイル・利用者固有データは除外する。
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/
.python-version

# --- ツール／キャッシュ ---
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node（dev ツールのみ）---
node_modules/

# --- レビューシステム（方式A: wheel + init）---
# TS エンジンサイドカーは各環境で init --with-engines により再生成されるため追跡しない。
.ame-review/engines-ts/

# --- OS / 同期クライアント ---
Thumbs.db
ehthumbs.db
desktop.ini
*.tmp
.DS_Store

# --- エディタ ---
.vscode/
.idea/
*.swp
*~

# --- ユーザー固有設定 (Git 管理対象外) ---
config.user.json
.env

# --- Docker ビルドシークレット（実ファイルのみ除外、.example は追跡） ---
secrets/user_password.txt

# --- Claude Code のローカル個人設定 (プロジェクト共有設定 .claude/settings.json は追跡する) ---
.claude/settings.local.json

# --- AI エージェント / ツール状態 (セッション・利用者固有) ---
.serena/
AGENTS.md
.tokensave/
